[Unit]
Description=Aura personal photo library
After=network.target

[Service]
Type=simple
User=aura
Group=aura
WorkingDirectory=/opt/aura
ExecStart=/opt/aura/bin/aura serve --data /opt/aura/data --listen 127.0.0.1:18087 --workers 8 --gpu-slots 4
Environment=TZ=Asia/Shanghai
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MAGICK_THREAD_LIMIT=1
Environment=AURA_PLAYBACK_CACHE=/run/aura/playback
Environment=CUDA_CACHE_PATH=/run/aura/playback
Environment=CUDA_CACHE_MAXSIZE=33554432
RuntimeDirectory=aura
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/aura/data
Nice=5
TasksMax=1024

[Install]
WantedBy=multi-user.target
