{
  "id": "aura",
  "name": "Aura",
  "description": "个人照片与实况照片库。",
  "icon": "/aura/apple-touch-icon.png",
  "url": "/aura/",
  "repo": "https://github.com/Crashmere/Aura",
  "root": "/opt/aura",
  "port": 18087,
  "user": "aura",
  "units": [
    "aura.service"
  ],
  "database": "/opt/aura/data/aura.sqlite",
  "resources": [
    {
      "id": "data",
      "name": "业务数据",
      "path": "/opt/aura/data",
      "purpose": "元数据、相片集及照片关联、分片和处理状态、资源分组与导入来源；保留主版本、相似忽略、Apple 相册映射及永久删除意图、清理状态和最小防重导入标记。",
      "kind": "data",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "originals",
      "name": "照片原件",
      "path": "/opt/aura/data/assets",
      "purpose": "SHA-256 寻址的原始照片、实况视频、RAW 与编辑资源，不改写字节；仅明确确认永久删除所选最近删除项目时移除其现用原件，不影响已有备份。",
      "kind": "media",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "derived",
      "name": "预览缓存",
      "path": "/opt/aura/data/derived",
      "purpose": "可再生缩略图、浏览预览和兼容播放视频；nas 手工全量备份和升级冷副本完整收录，原生工具仍不收录。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "incoming",
      "name": "上传暂存",
      "path": "/opt/aura/data/incoming",
      "purpose": "已确认写入但尚未提交的持久化分片；nas 手工全量备份和升级冷副本完整收录。恢复旧状态后用 Apple 客户端核对回执，仅补传确认缺失且不在最近删除中的原件。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "work",
      "name": "处理暂存",
      "path": "/opt/aura/data/work",
      "purpose": "媒体提取工作目录，任务完成后删除。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "releases",
      "name": "部署版本",
      "path": "/opt/aura/releases",
      "purpose": "程序版本和发布结果用于回退与排查；nas 不做定时轮转，失败批次保留恢复记录，清理前由 agent 确认具体范围。",
      "kind": "releases",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "config",
      "name": "运行配置",
      "path": "/opt/aura/config",
      "purpose": "systemd、Nginx、资源声明与发布来源。",
      "kind": "config",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "bin",
      "name": "服务程序",
      "path": "/opt/aura/bin",
      "purpose": "服务程序与固定发布脚本。",
      "kind": "binaries",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "docs",
      "name": "维护文档",
      "path": "/opt/aura/docs",
      "purpose": "架构、API、Apple 客户端、部署与恢复说明。",
      "kind": "documents",
      "browse": true,
      "cleanup": false
    }
  ],
  "apis": [
    {
      "method": "GET",
      "path": "/healthz",
      "description": "数据库连接健康"
    },
    {
      "method": "GET",
      "path": "/api/info",
      "description": "版本、能力声明、照片库数量、原件体积与处理状态"
    },
    {
      "method": "GET",
      "path": "/api/assets",
      "description": "按相片集、类型、拍摄日期、关键词查询照片；游标分页"
    },
    {
      "method": "GET",
      "path": "/api/filter-options",
      "description": "全库设备和镜头选项，包含最近删除和次要原件；去重排序，不受筛选或分页影响"
    },
    {
      "method": "PATCH",
      "path": "/api/assets",
      "description": "原子批量移入最近删除或恢复；失败不部分提交"
    },
    {
      "method": "POST",
      "path": "/api/assets/purge",
      "description": "二次确认永久删除所选最近删除项目；持久化意图后清理全部原件与预览，不改动系统照片或已有备份"
    },
    {
      "method": "GET",
      "path": "/api/deletions/{id}",
      "description": "永久删除请求的待清理、错误及完成状态；中断后继续"
    },
    {
      "method": "GET",
      "path": "/api/timeline",
      "description": "与照片列表筛选一致的拍摄月份及项目数量"
    },
    {
      "method": "GET",
      "path": "/api/albums",
      "description": "相片集列表、可见项目数与最新封面"
    },
    {
      "method": "POST",
      "path": "/api/albums",
      "description": "新建相片集并原子添加所选照片"
    },
    {
      "method": "POST",
      "path": "/api/albums/import",
      "description": "Apple 相册来源映射与增量添加；保留 Aura 命名和删除决定"
    },
    {
      "method": "GET",
      "path": "/api/albums/{id}",
      "description": "相片集名称、数量、封面与时间"
    },
    {
      "method": "PATCH",
      "path": "/api/albums/{id}",
      "description": "重命名相片集"
    },
    {
      "method": "DELETE",
      "path": "/api/albums/{id}",
      "description": "删除相片集及关联，保留照片和原件"
    },
    {
      "method": "POST",
      "path": "/api/albums/{id}/assets",
      "description": "批量添加照片到相片集；重复添加不产生副本"
    },
    {
      "method": "DELETE",
      "path": "/api/albums/{id}/assets",
      "description": "批量移除相片集关联，照片仍在照片库中"
    },
    {
      "method": "GET",
      "path": "/api/assets/{id}",
      "description": "照片详情、全部原件与合并元数据"
    },
    {
      "method": "PATCH",
      "path": "/api/assets/{id}",
      "description": "收藏、最近删除、恢复与持久主版本选择"
    },
    {
      "method": "POST",
      "path": "/api/assets/{id}/merge",
      "description": "手工归并照片，保留所有原件"
    },
    {
      "method": "POST",
      "path": "/api/assets/{id}/split",
      "description": "将一个原始版本分离为独立项目"
    },
    {
      "method": "GET",
      "path": "/api/assets/{id}/download",
      "description": "下载全部原件与来源清单 ZIP"
    },
    {
      "method": "GET",
      "path": "/api/similar",
      "description": "分页感知哈希相似候选，排除已忽略项目；仅供人工核对"
    },
    {
      "method": "POST",
      "path": "/api/similar/ignore",
      "description": "持久忽略指定相似候选，不合并或删除原件"
    },
    {
      "method": "DELETE",
      "path": "/api/similar/ignore",
      "description": "撤销指定相似候选的忽略决定"
    },
    {
      "method": "GET",
      "path": "/api/jobs",
      "description": "分页持久处理历史、状态数量与失败原因"
    },
    {
      "method": "POST",
      "path": "/api/files/{hash}/retry",
      "description": "重新生成元数据和预览"
    },
    {
      "method": "POST",
      "path": "/api/files/retry",
      "description": "原子批量重试失败媒体处理，保留原件"
    },
    {
      "method": "GET",
      "path": "/api/uploads",
      "description": "分页未完成上传、已确认偏移与缺失原件补传状态"
    },
    {
      "method": "POST",
      "path": "/api/uploads",
      "description": "按 SHA-256 准备或恢复上传；检查原件存在，保留最近删除状态"
    },
    {
      "method": "GET",
      "path": "/api/uploads/{id}",
      "description": "已接收偏移、提交及原件存在状态、当前项目与最近删除状态"
    },
    {
      "method": "PUT",
      "path": "/api/uploads/{id}",
      "description": "写入并同步最大 8 MiB 的分片"
    },
    {
      "method": "POST",
      "path": "/api/uploads/{id}/complete",
      "description": "完整哈希校验与原件提交"
    },
    {
      "method": "GET",
      "path": "/media/{hash}/{kind}",
      "description": "鉴权读取原件、缩略图、预览或实况视频；支持 Range"
    },
    {
      "method": "HEAD",
      "path": "/media/{hash}/{kind}",
      "description": "读取媒体响应头"
    }
  ]
}
